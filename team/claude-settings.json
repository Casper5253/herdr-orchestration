      "Bash(herdr pane send-text:*)",
      "PowerShell(herdr pane send-text:*)",
      "Bash(herdr pane send-keys:*)",
      "PowerShell(herdr pane send-keys:*)",
      "Bash(herdr pane close:*)",
      "PowerShell(herdr pane close:*)",
      "Bash(herdr workspace close:*)",
      "PowerShell(herdr workspace close:*)",
      "Bash(herdr server:*)",
      "PowerShell(herdr server:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python \"C:/Users/caspe/Documents/Projects/herdr-orchestration/hooks/claude_statusline.py\""
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/caspe/Documents/Projects/herdr-orchestration/hooks/claude_precompact.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/caspe/Documents/Projects/herdr-orchestration/hooks/claude_session_compact.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
