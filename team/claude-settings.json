      "Bash(herdr agent get:*)",
      "PowerShell(herdr agent get:*)",
      "Bash(herdr agent read:*)",
      "PowerShell(herdr agent read:*)",
      "Bash(herdr agent wait:*)",
      "PowerShell(herdr agent wait:*)",
      "Bash(herdr pane list:*)",
      "PowerShell(herdr pane list:*)",
      "Bash(herdr pane read:*)",
      "PowerShell(herdr pane read:*)",
      "Bash(herdr status:*)",
      "PowerShell(herdr status:*)",
      "Bash(herdr --skill:*)",
      "PowerShell(herdr --skill:*)",
      "Bash(herdr agent prompt dev-codex:*)",
      "PowerShell(herdr agent prompt dev-codex:*)",
      "Bash(herdr agent prompt dev-opencode:*)",
      "PowerShell(herdr agent prompt dev-opencode:*)",
      "Bash(herdr agent prompt hx-codex:*)",
