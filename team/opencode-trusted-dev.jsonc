{
  "$schema": "https://opencode.ai/config.json",
  // Persistent team worker model, same as policy.persistent_opencode_model (owner directive 2026-11-06).
  "model": "opencode-go/deepseek-v4.1-flash",
  // Herdr trusted dev team overlay, loaded only via OPENCODE_CONFIG by Start-HerdrTeam.ps1.
  // OpenCode 1.18 applies the LAST matching rule, so the narrow allows come after the herdr ask.
  "permission": {
    "bash": {
      "*": "allow",
      "herdr *": "ask",
      // Team messages use `hx say` (allowed by "*"), which only reaches the own team; raw prompts ask.
      "herdr agent list*": "allow",
      "herdr agent get *": "allow",
      "herdr agent read *": "allow",
      "herdr agent wait *": "allow",
      "herdr pane list*": "allow",
      "herdr pane read *": "allow",
      "herdr status*": "allow",
      "herdr --skill*": "allow"
    },
    // Skills live outside every repo (poteto-mode reads pstack leaves by path), so asking here stalled each brief.
    "external_directory": {
      "*": "ask",
      "C:\\Users\\caspe\\.agents\\*": "allow",
      "C:\\Users\\caspe\\.claude\\skills\\*": "allow"
    },
    // Reading skills is fine; changing them goes through ~/.agents and sync.py, never a worker.
    "edit": {
      "*": "allow",
      "C:\\Users\\caspe\\.agents\\*": "deny",
      "C:\\Users\\caspe\\.claude\\skills\\*": "deny"
    }
  }
}
