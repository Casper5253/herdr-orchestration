  "codex": {
    "file": "team/herdr-team.rules",
    "note": "The Codex prefix_rule list, in file order. 'prompt' is Codex's ask decision; it is the hard stop because team Codex runs without a sandbox.",
    "rules": [
      {
        "comments": [
          "# Herdr trusted dev team. Rollback: delete this file.",
          "# Read-only discovery/status: run outside the sandbox without prompting."
        ],
        "decision": "allow",
        "pattern": [
          "herdr",
          "agent",
          [
            "list",
            "get",
            "read",
            "wait"
          ]
        ]
      },
      {
        "comments": [],
        "decision": "allow",
        "pattern": [
          "herdr",
          "pane",
          [
            "list",
            "read",
            "current",
            "layout",
            "get"
          ]
        ]
      },
      {
        "comments": [],
        "decision": "allow",
        "pattern": [
          "herdr",
          [
            "workspace",
            "tab"
          ],
          "list"
        ]
      },
      {
        "comments": [],
        "decision": "allow",
        "pattern": [
          "herdr",
          "status"
        ]
      },
      {
        "comments": [],
        "decision": "allow",
        "pattern": [
          "herdr",
          "--skill"
        ]
      },
      {
        "comments": [
          "# Team messages go through `hx say`, which only reaches the sender's own team (allowed by the hx rules below).",
          "# A raw prompt could reach any agent, including another team's, so it asks."
        ],
        "decision": "prompt",
        "pattern": [
          "herdr",
          "agent",
          "prompt"
        ]
      },
      {
        "comments": [
          "# Keyboard injection, raw pane control and agent lifecycle stay with the user."
        ],
        "decision": "prompt",
        "pattern": [
          "herdr",
          "agent",
          [
            "send-keys",
            "start",
            "rename",
            "focus",
            "attach"
          ]
        ]
      },
      {
        "comments": [],
        "decision": "prompt",
        "pattern": [
          "herdr",
          "pane",
          [
            "run",
            "send-text",
            "send-keys",
            "close",
            "split",
            "move",
            "input"
          ]
        ]
      },
      {
        "comments": [],
        "decision": "prompt",
        "pattern": [
          "herdr",
          [
            "workspace",
            "tab",
            "server",
            "worktree"
          ],
          [
            "create",
            "close",
            "stop"
          ]
        ]
      },
      {
        "comments": [
          "# Herdr app (herdr-core, `hc`), added 2026-11-09 on the owner's request for one report path for every worker.",
          "# Reads are free. Reports go through `hx say`, which enforces the team boundary and the outbox;",
          "# a raw `hc send` could reach any terminal, so it asks. Starting, ending or typing keys asks."
        ],
        "decision": "allow",
        "pattern": [
          "hc",
          [
            "ls",
            "get",
            "read",
            "wait",
            "templates",
            "schema",
            "--help"
          ]
        ]
      },
      {
        "comments": [],
        "decision": "prompt",
        "pattern": [
          "hc",
          "send"
        ]
      },
      {
        "comments": [],
        "decision": "prompt",
        "pattern": [
          "hc",
          [
            "run",
            "kill",
            "rm",
            "keys",
            "interrupt",
            "label",
            "keep",
            "attach",
            "server",
            "exec",
            "file",
            "put"
          ]
        ]
      },
      {
        "comments": [
          "# Routine in-repo dev work (added 2026-10-12 to stop repeated approval prompts).",
          "# The project venv's base python lives under WindowsApps, which the MXC sandbox blocks, so these must run unprompted outside it.",
          "# Only plain commands match: no pipes, ';', '&&', $env expressions or powershell -Command wrappers."
        ],
        "decision": "allow",
        "pattern": [
          [
            "backend/.venv/Scripts/python.exe",
            "backend\\.venv\\Scripts\\python.exe",
            ".venv/Scripts/python.exe",
            ".venv\\Scripts\\python.exe"
          ]
        ]
      },
      {
        "comments": [],
        "decision": "allow",
        "pattern": [
          "git"
        ]
      },
      {
        "comments": [],
        "decision": "allow",
        "pattern": [
          "npm",
          "run",
          [
            "build",
            "lint",
            "test"
          ]
        ]
      },
      {
        "comments": [],
        "decision": "allow",
        "pattern": [
          "npm.cmd",
          "run",
          [
            "build",
            "lint",
            "test"
          ]
        ]
      },
      {
        "comments": [
          "# Team Codex runs without a sandbox (owner decision 2026-10-18), so these are the hard stop for destructive git.",
          "# The stricter decision wins over the plain git allow above."
        ],
        "decision": "prompt",
        "pattern": [
          "git",
          [
            "push",
            "reset",
            "clean",
            "rebase",
            "filter-branch",
            "filter-repo",
            "reflog",
            "gc",
            "prune",
            "update-ref"
          ]
        ]
      },
      {
        "comments": [],
        "decision": "prompt",
        "pattern": [
          "git",
          "branch",
          [
            "-D",
            "-d",
            "--delete",
            "-f",
            "--force"
          ]
        ]
      },
      {
        "comments": [],
        "decision": "prompt",
        "pattern": [
          "git",
          "checkout",
          [
            "-f",
            "--force",
            "--",
            "."
          ]
        ]
      },
      {
        "comments": [],
        "decision": "prompt",
        "pattern": [
          "git",
          "restore"
        ]
      },
      {
        "comments": [],
        "decision": "prompt",
        "pattern": [
          "git",
          "worktree",
          [
            "remove",
            "prune"
          ]
        ]
      },
      {
        "comments": [],
        "decision": "prompt",
        "pattern": [
          "git",
          "stash",
          [
            "drop",
            "clear"
          ]
        ]
      },
      {
        "comments": [
          "# pytest still runs through python; hx itself must run through the pinned shim."
        ],
        "decision": "allow",
        "pattern": [
          "python",
          "-m",
          "pytest"
        ]
      },
      {
        "comments": [],
        "decision": "allow",
        "pattern": [
          "hx"
        ]
      },
      {
        "comments": [
          "# Absolute path to the Personal Finance Dashboard venv, used from worktrees (added 2026-10-16)."
        ],
        "decision": "allow",
        "pattern": [
          [
            "C:/Users/caspe/Documents/Projects/Personal Finance Dashboard/backend/.venv/Scripts/python.exe",
            "C:\\Users\\caspe\\Documents\\Projects\\Personal Finance Dashboard\\backend\\.venv\\Scripts\\python.exe",
            "../../backend/.venv/Scripts/python.exe",
            "..\\..\\backend\\.venv\\Scripts\\python.exe"
          ]
        ]
      },
      {
        "comments": [
          "# QuantLab venv, used from the main checkout and from worktrees (added 2026-10-17, owner request)."
        ],
        "decision": "allow",
        "pattern": [
          [
            "C:/Users/caspe/Documents/Projects/QuantLab/quantlab/.venv/Scripts/python.exe",
            "C:\\Users\\caspe\\Documents\\Projects\\QuantLab\\quantlab\\.venv\\Scripts\\python.exe",
            "../../quantlab/.venv/Scripts/python.exe",
            "..\\..\\quantlab\\.venv\\Scripts\\python.exe",
            "../quantlab/.venv/Scripts/python.exe",
            "..\\quantlab\\.venv\\Scripts\\python.exe"
          ]
        ]
      },
      {
        "comments": [
          "# Installed Edge, for headless render checks and screenshots (added 2026-10-17, owner request)."
        ],
        "decision": "allow",
        "pattern": [
          [
            "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
            "C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe",
            "msedge",
