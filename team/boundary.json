      },
      {
        "comments": [],
        "decision": "allow",
        "pattern": [
          "hc",
          "keys",
          "t2x",
          "enter"
        ]
      },
      {
        "comments": [],
        "decision": "allow",
        "pattern": [
          "C:\\windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
